// Development only. Keep the committed native tables aligned with web colors.
import { writeFile } from 'node:fs/promises';
import { bytePalette, bitPalette, metricPalette, activityPalette } from '../../src/aram/palettes.ts';
const presets = ['spectrum', 'scope', 'original', 'grayscale', 'accessible'] as const;
const pack = (rgba: number[]) => '0x' + ((rgba[0] | (rgba[1] << 8) | (rgba[2] << 16) | (255 << 24)) >>> 0).toString(16) + 'u';
let output = '// Generated by windows/tools/export-palettes.mts from src/aram/palettes.ts.\n#pragma once\n#include <cstdint>\nnamespace visual_spc {\ninline constexpr std::uint32_t paletteTables[5][4][256] = {\n';
for (const preset of presets) {
  output += '{\n';
  const off = bitPalette(false, preset), on = bitPalette(true, preset);
  const rows = [
    Array.from({ length: 256 }, (_, i) => bytePalette(i, preset)),
    Array.from({ length: 256 }, (_, i) => [0, 1, 2].map(c => Math.round(off[c] + (on[c] - off[c]) * i / 255)).concat(255)),
    Array.from({ length: 256 }, (_, i) => metricPalette(i / 255, preset)),
    Array.from({ length: 256 }, (_, i) => activityPalette(i & 7, preset)),
  ];
  for (const row of rows) {
    output += '{\n';
    for (let i = 0; i < 256; i += 8) output += row.slice(i, i + 8).map(pack).join(', ') + ',\n';
    output += '},\n';
  }
  output += '},\n';
}
output += '};\n}\n';
await writeFile(new URL('../src/model/PaletteTables.h', import.meta.url), output);
