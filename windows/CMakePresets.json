{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/x64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-x64-debug",
      "binaryDir": "${sourceDir}/out/x64-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-x64-release-no-ipo",
      "inherits": "windows-x64-release",
      "binaryDir": "${sourceDir}/out/x64-release-no-ipo",
      "cacheVariables": { "SPC_ENABLE_IPO": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release" },
    { "name": "windows-x64-release-no-ipo", "configurePreset": "windows-x64-release-no-ipo" }
  ],
  "testPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "output": { "outputOnFailure": true } }
  ]
}
